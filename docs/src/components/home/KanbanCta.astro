---
import boardDark from '../../assets/home/board-cta-dark.png';
import boardLight from '../../assets/home/board-cta-light.png';
---

<section class="kanban-cta not-content">
  <div class="kanban-cta__copy">
    <h2 class="kanban-cta__title">See your pipeline as a board</h2>
    <p class="kanban-cta__tagline">
      Visualize your autoducks-installed repo with the interactive Kanban board.
    </p>

    <form class="kanban-cta__form" id="kanban-cta-form" action="/dashboard" method="get" novalidate>
      <label class="kanban-cta__label" for="kanban-cta-repo">Repository</label>
      <div class="kanban-cta__field">
        <input
          class="kanban-cta__input"
          type="text"
          id="kanban-cta-repo"
          name="repo"
          placeholder="org/repo"
          autocomplete="off"
          aria-describedby="kanban-cta-error"
        />
        <button class="kanban-cta__button" type="submit">View board</button>
      </div>
      <p class="kanban-cta__error" id="kanban-cta-error" role="alert" hidden></p>
    </form>
  </div>

  <figure class="kanban-cta__figure">
    <img
      class="kanban-cta__image kanban-cta__image--dark"
      src={boardDark.src}
      width={boardDark.width}
      height={boardDark.height}
      alt="An autoducks board with example issues across Design, Tactics, Delivery and Review columns"
      loading="lazy"
      decoding="async"
    />
    <img
      class="kanban-cta__image kanban-cta__image--light"
      src={boardLight.src}
      width={boardLight.width}
      height={boardLight.height}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
    <figcaption class="kanban-cta__caption">Preview shown with example data, not your live board</figcaption>
  </figure>
</section>

<script is:inline>
  (function () {
    var REPO_PATTERN = /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/;

    var form = document.getElementById('kanban-cta-form');
    var input = document.getElementById('kanban-cta-repo');
    var error = document.getElementById('kanban-cta-error');

    function showError(message) {
      if (!error) return;
      error.textContent = message;
      error.hidden = false;
    }

    function hideError() {
      if (!error) return;
      error.hidden = true;
      error.textContent = '';
    }

    if (form) {
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        var repo = input ? input.value.trim() : '';

        if (repo === '') {
          hideError();
          window.location.href = '/dashboard';
          return;
        }

        if (!REPO_PATTERN.test(repo)) {
          showError('Enter a repository as "org/repo".');
          return;
        }

        hideError();
        window.location.href = '/dashboard?repo=' + encodeURIComponent(repo);
      });
    }
  })();
</script>

<style>
  .kanban-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    margin: 2.5rem auto;
    max-width: 64rem;
    padding-inline: 1rem;
  }

  .kanban-cta__copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1 1 22rem;
    min-width: 0;
  }

  .kanban-cta__title {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .kanban-cta__tagline {
    margin: 0;
    max-width: 32rem;
    color: var(--sl-color-gray-2);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .kanban-cta__form {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 26rem;
  }

  .kanban-cta__label {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }

  .kanban-cta__field {
    display: flex;
    gap: 0.5rem;
  }

  .kanban-cta__input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.35rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-1);
    font-family: var(--__sl-font-mono);
    font-size: 0.9rem;
  }

  .kanban-cta__button {
    padding: 0.5rem 1.1rem;
    border: none;
    border-radius: 0.35rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    font-family: var(--sl-font);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s ease;
  }

  .kanban-cta__button:hover {
    background: var(--sl-color-accent-high);
  }

  .kanban-cta__error {
    margin: 0;
    color: var(--sl-color-accent-high);
    font-size: 0.8rem;
  }

  .kanban-cta__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    flex: 1 1 22rem;
    max-width: 30rem;
    min-width: 0;
  }

  .kanban-cta__image {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    border-radius: 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
  }
  /* Show the variant matching the active theme. */
  .kanban-cta__image--light {
    display: none;
  }
  :global(:root[data-theme='light']) .kanban-cta__image--dark {
    display: none;
  }
  :global(:root[data-theme='light']) .kanban-cta__image--light {
    display: block;
  }

  .kanban-cta__caption {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .kanban-cta__button,
    .kanban-cta__image {
      transition: none;
    }
  }
</style>
