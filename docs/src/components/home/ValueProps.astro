---
const differentiators = [
  {
    title: 'BYO harness & subscription',
    description:
      'Bring your own Claude Code subscription or API key — no separate metered billing to manage.',
  },
  {
    title: 'Native triggers & state',
    description:
      'Issues, comments, and labels are the state machine. No external dashboard or queue to run.',
  },
  {
    title: 'LLM for reasoning, bash for orchestration',
    description:
      'The model plans, designs, and reviews; deterministic scripts drive git, gh, and CI.',
  },
  {
    title: 'Pluggable providers',
    description:
      'Swap the model or the runtime without rewriting the pipeline.',
  },
];
---

<section class="value-props not-content">
  <ul class="value-props__grid">
    {
      differentiators.map((item) => (
        <li class="value-props__item">
          <p class="value-props__item-title">{item.title}</p>
          <p class="value-props__item-desc">{item.description}</p>
        </li>
      ))
    }
  </ul>

  <div class="value-props__cta">
    <h2 class="value-props__cta-heading">Run your first issue</h2>
    <div class="value-props__cta-actions">
      <a class="value-props__button value-props__button--primary" href="/getting-started/first-run">
        Run your first issue
      </a>
      <a class="value-props__button value-props__button--secondary" href="/getting-started/introduction">
        Read the introduction
      </a>
      <a class="value-props__button value-props__button--tertiary" href="https://github.com/deepducks/autoducks">
        View on GitHub
      </a>
    </div>
  </div>
</section>

<style>
  .value-props {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    margin: 2.5rem auto;
    padding-inline: 1rem;
  }

  .value-props__grid {
    display: grid;
    width: 100%;
    max-width: 64rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .value-props__item {
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .value-props__item:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }

  .value-props__item-title {
    margin: 0 0 0.4rem;
    color: var(--sl-color-white);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .value-props__item-desc {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .value-props__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .value-props__cta-heading {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .value-props__cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .value-props__button {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.25rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .value-props__button--primary {
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
  }

  .value-props__button--primary:hover {
    background: var(--sl-color-accent-high);
  }

  .value-props__button--secondary {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
    background: transparent;
  }

  .value-props__button--secondary:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }

  .value-props__button--tertiary {
    color: var(--sl-color-gray-2);
    background: transparent;
  }

  .value-props__button--tertiary:hover {
    color: var(--sl-color-white);
  }

  @media (prefers-reduced-motion: reduce) {
    .value-props__item,
    .value-props__button {
      transition: none;
    }

    .value-props__item:hover {
      transform: none;
    }
  }
</style>
