---
// Full-width page shell, deliberately outside Starlight's content pipeline
// (src/pages, not src/content/docs) so it renders without Starlight's
// sidebar/ToC chrome. It borrows Starlight's design tokens by importing the
// same stylesheet and resolving `data-theme` the same way Mermaid.astro does.
import '../styles/custom.css';
import KanbanBoard from '../components/dashboard/KanbanBoard.astro';

const DEFAULT_REPO = 'deepducks/autoducks';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard | autoducks</title>
    <script is:inline>
      (function () {
        // Same storage key Starlight's own theme picker uses, so this
        // standalone page matches whatever the visitor picked on the docs.
        var stored = localStorage.getItem('starlight-theme');
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="dashboard-header">
      <a href="/" class="dashboard-header__logo" aria-label="autoducks home">autoducks</a>

      <form class="dashboard-header__repo-form" id="repo-form" novalidate>
        <input
          type="text"
          id="repo-input"
          name="repo"
          placeholder="org/repo"
          autocomplete="off"
          aria-describedby="repo-error"
        />
        <button type="submit">Go</button>
      </form>

      <label class="dashboard-header__auto-refresh">
        <input type="checkbox" id="auto-refresh-toggle" checked /> Auto-refresh
      </label>

      <button type="button" class="dashboard-header__cta" id="dashboard-cta">Your dashboard</button>
    </header>

    <p class="dashboard-header__error" id="repo-error" role="alert" hidden></p>

    <details class="dashboard-settings" id="settings">
      <summary>Settings</summary>
      <div class="dashboard-settings__body">
        <label for="token-input">GitHub personal access token</label>
        <input
          type="password"
          id="token-input"
          placeholder="GitHub personal access token (optional)"
          autocomplete="off"
        />
        <p class="dashboard-settings__hint">
          Stored only in this tab's session storage. Sent only to api.github.com.
        </p>
      </div>
    </details>

    <main class="dashboard-main" id="dashboard-main">
      <div id="board-mount">
        <KanbanBoard repo={DEFAULT_REPO} autoRefresh={true} />
      </div>
    </main>

    <script is:inline define:vars={{ DEFAULT_REPO }}>
      // Classic (non-module) script: executes synchronously during parsing,
      // before KanbanBoard's own bundled module script runs (module scripts
      // are always deferred). Setting data-repo here means the board's
      // first fetch already targets the resolved repo instead of the
      // placeholder, so there's no flash of a wrong/empty-repo error.
      (function () {
        var REPO_PATTERN = /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/;

        function resolveInitialRepo() {
          var fromQuery = new URLSearchParams(location.search).get('repo');
          if (fromQuery && REPO_PATTERN.test(fromQuery)) return fromQuery;

          var fromStorage = null;
          try {
            fromStorage = localStorage.getItem('autoducks.dashboard.repo');
          } catch {}
          if (fromStorage && REPO_PATTERN.test(fromStorage)) return fromStorage;

          return DEFAULT_REPO;
        }

        var repo = resolveInitialRepo();
        var boardEl = document.querySelector('.kanban-board');
        if (boardEl) boardEl.dataset.repo = repo;

        var repoInput = document.getElementById('repo-input');
        if (repoInput) repoInput.value = repo;

        var tokenInput = document.getElementById('token-input');
        if (tokenInput) {
          try {
            tokenInput.value = sessionStorage.getItem('autoducks.dashboard.token') ?? '';
          } catch {}
        }
      })();
    </script>

    <script>
      const REPO_PATTERN = /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/;

      const form = document.getElementById('repo-form') as HTMLFormElement | null;
      const repoInput = document.getElementById('repo-input') as HTMLInputElement | null;
      const repoError = document.getElementById('repo-error') as HTMLElement | null;
      const tokenInput = document.getElementById('token-input') as HTMLInputElement | null;
      const autoRefreshToggle = document.getElementById('auto-refresh-toggle') as HTMLInputElement | null;
      const cta = document.getElementById('dashboard-cta') as HTMLElement | null;
      const boardEl = document.querySelector<HTMLElement>('.kanban-board');

      function showRepoError(message: string): void {
        if (!repoError) return;
        repoError.textContent = message;
        repoError.hidden = false;
      }

      function hideRepoError(): void {
        if (!repoError) return;
        repoError.hidden = true;
        repoError.textContent = '';
      }

      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const repo = repoInput?.value.trim() ?? '';

        if (!REPO_PATTERN.test(repo)) {
          showRepoError('Enter a repository as "org/repo".');
          return;
        }

        hideRepoError();
        localStorage.setItem('autoducks.dashboard.repo', repo);

        const url = new URL(location.href);
        url.searchParams.set('repo', repo);
        history.pushState({}, '', url);

        if (boardEl) boardEl.dataset.repo = repo;
      });

      tokenInput?.addEventListener('input', () => {
        const value = tokenInput.value;
        if (value) {
          sessionStorage.setItem('autoducks.dashboard.token', value);
        } else {
          sessionStorage.removeItem('autoducks.dashboard.token');
        }
      });

      autoRefreshToggle?.addEventListener('change', () => {
        if (!boardEl) return;
        boardEl.dataset.autoRefresh = String(autoRefreshToggle.checked);
        // The board only reloads on data-repo mutations; removing then
        // restoring the attribute is what makes the new auto-refresh
        // setting take effect without duplicating KanbanBoard's own reload
        // logic here (re-setting the same value isn't reliably observed).
        const repo = boardEl.dataset.repo;
        boardEl.removeAttribute('data-repo');
        if (repo) boardEl.dataset.repo = repo;
      });

      cta?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        repoInput?.focus();
      });
    </script>

    <style>
      :global(html),
      :global(body) {
        margin: 0;
        padding: 0;
        background: var(--sl-color-gray-7);
        color: var(--sl-color-gray-1);
        font-family: var(--sl-font);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      .dashboard-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--sl-color-gray-5);
        background: var(--sl-color-gray-6);
      }

      .dashboard-header__logo {
        font-family: var(--sl-font);
        font-weight: 700;
        font-size: 1.1rem;
        color: var(--sl-color-gray-1);
        text-decoration: none;
      }

      .dashboard-header__repo-form {
        display: flex;
        gap: 0.5rem;
        flex: 1 1 auto;
        min-width: 220px;
      }

      .dashboard-header__repo-form input {
        flex: 1 1 auto;
        min-width: 0;
        padding: 0.4rem 0.7rem;
        border: 1px solid var(--sl-color-gray-4);
        border-radius: 0.35rem;
        background: var(--sl-color-gray-7);
        color: var(--sl-color-gray-1);
        font-family: var(--sl-font-mono);
        font-size: 0.9rem;
      }

      .dashboard-header__repo-form button {
        padding: 0.4rem 0.9rem;
        border: 1px solid var(--sl-color-gray-4);
        border-radius: 0.35rem;
        background: var(--sl-color-gray-5);
        color: var(--sl-color-gray-1);
        font-size: 0.9rem;
        cursor: pointer;
      }

      .dashboard-header__repo-form button:hover {
        background: var(--sl-color-gray-4);
      }

      .dashboard-header__auto-refresh {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        color: var(--sl-color-gray-2);
        white-space: nowrap;
      }

      .dashboard-header__cta {
        padding: 0.5rem 1.1rem;
        border: none;
        border-radius: 0.4rem;
        background: var(--sl-color-accent);
        color: var(--sl-color-text-invert);
        font-family: var(--sl-font);
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        white-space: nowrap;
      }

      .dashboard-header__cta:hover {
        opacity: 0.9;
      }

      .dashboard-header__error {
        margin: 0;
        padding: 0.6rem 1.5rem;
        color: var(--sl-color-accent-high);
        background: var(--sl-color-accent-low);
        font-size: 0.85rem;
      }

      .dashboard-settings {
        border-bottom: 1px solid var(--sl-color-gray-5);
      }

      .dashboard-settings summary {
        padding: 0.6rem 1.5rem;
        cursor: pointer;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--sl-color-gray-2);
      }

      .dashboard-settings__body {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 0 1.5rem 1rem;
        max-width: 32rem;
      }

      .dashboard-settings__body label {
        font-size: 0.8rem;
        color: var(--sl-color-gray-2);
      }

      .dashboard-settings__body input {
        padding: 0.4rem 0.7rem;
        border: 1px solid var(--sl-color-gray-4);
        border-radius: 0.35rem;
        background: var(--sl-color-gray-7);
        color: var(--sl-color-gray-1);
        font-family: var(--sl-font-mono);
        font-size: 0.85rem;
      }

      .dashboard-settings__hint {
        margin: 0;
        font-size: 0.75rem;
        color: var(--sl-color-gray-3);
      }

      .dashboard-main {
        padding: 1.5rem;
      }
    </style>
  </body>
</html>
