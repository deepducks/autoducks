---
import { Icon } from '@astrojs/starlight/components';
import type { AgentCard } from '../../lib/home/agents';

interface Props {
  agent: AgentCard;
}

const { agent } = Astro.props;
---

<a class="agent-card" href={agent.href}>
  <span class:list={['agent-card__icon', agent.accentClass]}>
    <Icon name={agent.icon} />
  </span>
  <span class="agent-card__layer">{agent.layer}</span>
  <h3 class="agent-card__name">{agent.name}</h3>
  <p class="agent-card__desc">{agent.description}</p>
  <ul class="agent-card__aliases">
    {
      agent.aliases.map((alias) => (
        <li>
          <code>/{alias}</code>
        </li>
      ))
    }
  </ul>
</a>

<style>
  .agent-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .agent-card:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }

  .agent-card:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .agent-card__icon {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
  }

  .agent-card__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .agent-card__layer {
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .agent-card__name {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .agent-card__desc {
    margin: 0;
    flex-grow: 1;
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .agent-card__aliases {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .agent-card__aliases code {
    border-radius: 0.3rem;
    background: var(--sl-color-gray-5);
    padding: 0.15rem 0.45rem;
    color: var(--sl-color-gray-1);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .agent-card {
      transition: none;
    }

    .agent-card:hover {
      transform: none;
    }
  }
</style>
