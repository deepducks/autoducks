---
// Full-width shell, deliberately outside Starlight's content pipeline
// (src/pages, not src/content/docs) so it renders without Starlight's
// sidebar/ToC chrome. It borrows Starlight's design tokens by importing the
// same stylesheet and resolving `data-theme` the same way Mermaid.astro does.
// All interactivity lives in the Board Svelte island.
import '../styles/custom.css';
import Board from '../components/dashboard/Board.svelte';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard | autoducks</title>
    <script is:inline>
      (function () {
        // Same storage key Starlight's own theme picker uses, so this
        // standalone page matches whatever the visitor picked on the docs.
        var stored = localStorage.getItem('starlight-theme');
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <main>
      <Board client:only="svelte" />
    </main>

    <style>
      :global(html),
      :global(body) {
        margin: 0;
        padding: 0;
        background: var(--sl-color-gray-7);
        color: var(--sl-color-gray-1);
        font-family: var(--sl-font);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
    </style>
  </body>
</html>
